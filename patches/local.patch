diff --git a/FufuLauncher.UnlockerIsland/Core/Hotkey.h b/FufuLauncher.UnlockerIsland/Core/Hotkey.h
new file mode 100644
index 0000000000000000000000000000000000000000..740cc7c40326d23c984b4cabc4de8846da9a8bd2
--- /dev/null
+++ b/FufuLauncher.UnlockerIsland/Core/Hotkey.h
@@ -0,0 +1,156 @@
+﻿/*
+Copyright (c) FufuLauncher Dev Team. All rights reserved.
+Licensed under the AGPL-3.0 License.
+*/
+#pragma once
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <atomic>
+
+// Hotkeys, and what counts as one.
+//
+// Every binding in config.ini is a single key, so a modified key is a different
+// shortcut and must not fire it: with FreeCamKey = Insert, Ctrl+Insert belongs
+// to whatever else asked for it, not to us. Every hotkey check in the plugin
+// goes through this header so that rule lives in one place.
+//
+// Header-only, like Utils.h: `inline` variables give the key table one instance
+// across all translation units, which is what lets the free camera's low-level
+// keyboard hook feed the state every other module reads.
+namespace Hotkey {
+
+    // A modifier and the two side-specific codes that stand for it.
+    struct Family {
+        int generic;    // what GetAsyncKeyState reports for either side
+        int left;
+        int right;
+    };
+
+    // A hotkey bound to a member of a family is not disqualified by that
+    // family: Shift on its own is a key like any other, Ctrl+Shift+that is not.
+    inline constexpr Family FAMILIES[] = {
+        { VK_CONTROL, VK_LCONTROL, VK_RCONTROL },
+        { VK_SHIFT,   VK_LSHIFT,   VK_RSHIFT   },
+        { VK_MENU,    VK_LMENU,    VK_RMENU    },
+        // The Windows key has no generic code; either side stands for it.
+        { VK_LWIN,    VK_LWIN,     VK_RWIN     },
+    };
+
+    // Key states as the low-level keyboard hook saw them.
+    //
+    // That hook exists to swallow the free camera's flight keys, and a
+    // swallowed key is hidden from GetAsyncKeyState as well -- measured under
+    // Wine, the state reads 0 while the key is physically held. The hook is
+    // then the only thing that still sees those keys, so it records every
+    // event here, including the ones it goes on to swallow.
+    inline std::atomic<bool> g_Down[256] = {};
+
+    // Record one key event. Called by the hook for every key, before it
+    // decides whether to swallow it.
+    inline void NoteKeyEvent(int vk, bool down) {
+        if (vk >= 0 && vk < 256) {
+            g_Down[vk].store(down, std::memory_order_relaxed);
+        }
+    }
+
+    // Is `vk` held down right now?
+    //
+    // The hook's table and the ordinary poll are combined rather than chosen
+    // between: the table is the only one that sees a swallowed key, and the
+    // poll is the only one that knows about a key that was already down when
+    // the hook went in. Neither can invent a key that is not held.
+    inline bool IsDown(int vk) {
+        if (vk <= 0 || vk >= 256) return false;   // 0 is "unbound" in config.ini
+        if (g_Down[vk].load(std::memory_order_relaxed)) return true;
+        if ((GetAsyncKeyState(vk) & 0x8000) != 0) return true;
+        // A low-level hook reports a modifier by its side-specific code, so a
+        // generic one (VK_SHIFT, VK_CONTROL, VK_MENU) never gets a table entry
+        // of its own -- and under Wine the poll above cannot see a key the hook
+        // is swallowing. Ask about both sides.
+        switch (vk) {
+        case VK_SHIFT:   return IsDown(VK_LSHIFT) || IsDown(VK_RSHIFT);
+        case VK_CONTROL: return IsDown(VK_LCONTROL) || IsDown(VK_RCONTROL);
+        case VK_MENU:    return IsDown(VK_LMENU) || IsDown(VK_RMENU);
+        default: return false;
+        }
+    }
+
+    // Is any key of `family` held?
+    inline bool FamilyDown(const Family& family) {
+        return IsDown(family.generic) || IsDown(family.left) ||
+            IsDown(family.right);
+    }
+
+    inline bool InFamily(const Family& family, int vk) {
+        return vk == family.generic || vk == family.left || vk == family.right;
+    }
+
+    // Is `vk` held as a bare key, with no modifier held as part of a shortcut?
+    inline bool IsSolo(int vk) {
+        if (!IsDown(vk)) return false;
+        for (const Family& family : FAMILIES) {
+            if (!InFamily(family, vk) && FamilyDown(family)) return false;
+        }
+        return true;
+    }
+
+    // One hotkey's state, to be checked once per tick.
+    //
+    // The latch is what carries "no modifiers" across a whole press. Asking
+    // only at the instant a hotkey acts would leave the tail of a Ctrl+Insert
+    // looking like a bare Insert: the key is still physically down when Ctrl
+    // comes up, so releasing the modifier first would fire the very binding
+    // the shortcut was meant not to reach.
+    class Latch {
+    public:
+        // Is the key held as a bare key? For hotkeys that repeat while held.
+        //
+        // Only one of `Held` and `Pressed` may be used for a given latch.
+        bool Held(int vk) {
+            Update(vk);
+            return armed_ && solo_;
+        }
+
+        // Is this the first tick of such a hold? For hotkeys that act once.
+        bool Pressed(int vk) {
+            Update(vk);
+            if (!armed_ || !solo_ || fired_) return false;
+            fired_ = true;
+            return true;
+        }
+
+    private:
+        void Update(int vk) {
+            // A rebind (config.ini was reloaded) starts over instead of
+            // carrying the old key's state into the new one.
+            if (vk != vk_) {
+                vk_ = vk;
+                down_ = false;
+                armed_ = false;
+                fired_ = false;
+            }
+            const bool down = IsDown(vk);
+            const bool solo = down && IsSolo(vk);
+            if (down && !down_) {
+                // Whether a press counts is decided when it starts: one that
+                // begins with a modifier held stays disarmed until the key has
+                // been released and pressed again on its own.
+                armed_ = solo;
+                fired_ = false;
+            } else if (!down) {
+                armed_ = false;
+                fired_ = false;
+            }
+            solo_ = solo;
+            down_ = down;
+        }
+
+        int vk_ = 0;
+        bool down_ = false;    // Key state at the previous check.
+        bool solo_ = false;    // Held as a bare key at the previous check.
+        bool armed_ = false;   // The current hold began as a bare press.
+        bool fired_ = false;   // `Pressed` has already answered for this hold.
+    };
+}
